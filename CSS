body {
    margin: 0;
    min-height: 100vh;
    background: linear-gradient(135deg, #141e30, #243b55);
    color: white;
    font-family: Arial, sans-serif;
    text-align: center;
}


.page {
    margin-top: 80px;
}


.hidden {
    display: none;
}


h1 {
    font-size: 55px;
    margin-bottom: 10px;
}


h2 {
    font-size: 30px;
}


p {
    font-size: 20px;
}


button {
    padding: 15px 30px;
    margin: 10px;
    border: none;
    border-radius: 12px;
    font-size: 18px;
    cursor: pointer;
    background: white;
    color: #222;
    transition: 0.2s;
}


button:hover {
    transform: scale(1.08);
}


#backButton {
    position: fixed;
    top: 20px;
    left: 20px;
    display: none;
}


#categories button,
#topicButtons button {
    display: block;
    width: 300px;
    margin: 15px auto;
}


#answers {
    margin-top: 20px;
}


.answer {
    display: block;
    width: 350px;
    margin: 15px auto;
}


.correct {
    background: green !important;
    color: white;
}


.wrong {
    background: red !important;
    color: white;
}


#quiz button {
    margin-top: 20px;
}
